# ==================================================
# API
# ==================================================
# Base URL of the Luxury Perfume Store API (see backend API_BLUEPRINT.md).
# Must include the versioned prefix, e.g. http://localhost:3000/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Request timeout (ms) applied to the shared Axios instance (src/lib/axios.ts)
VITE_API_TIMEOUT_MS=15000

# ==================================================
# App Metadata
# ==================================================
VITE_APP_NAME="Luxury Perfume Store"
VITE_APP_ENV=development

# ==================================================
# Dev Server
# ==================================================
VITE_DEV_SERVER_PORT=5173
