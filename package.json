{
  "name": "kenz-web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for KENZ — React 19 + TypeScript + Vite.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
